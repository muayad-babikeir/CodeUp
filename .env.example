# CodeUp has no local .env loader. These are SERVER-SIDE secrets for Supabase Edge Functions.
# Set them with: supabase secrets set NAME=value   (or the Supabase dashboard).
# Never commit real values. SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# are provided automatically by Supabase to Edge Functions.

# Used by: archive-student-files, telegram-import, telegram-resource-cleanup, telegram-team-topic
# Must match the 'x-cron-secret' header used by the pg_cron jobs.
# archive-student-files returns 503 when this is empty (fail closed).
CRON_SECRET=

# Used by: archive-student-files, telegram-group-check, telegram-import,
#          telegram-resource-cleanup, telegram-send-immediate, telegram-team-topic,
#          telegram-upload-resource
TELEGRAM_BOT_TOKEN=

# Used by: telegram-send-immediate, archive-student-files (student file archive group)
TELEGRAM_ARCHIVE_CHAT_ID=

# Used by: telegram-team-topic (forum supergroup for teams/squads)
TELEGRAM_TEAMS_CHAT_ID=
# Optional invite link returned to users
TELEGRAM_TEAMS_INVITE_LINK=

# Used by: google-wallet (full service-account JSON as one string)
GOOGLE_WALLET_SERVICE_ACCOUNT=

# Client side (not an env var): edit SUPABASE_URL / SUPABASE_ANON_KEY in js/supabase.js
